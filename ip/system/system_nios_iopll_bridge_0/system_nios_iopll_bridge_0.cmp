	component system_nios_iopll_bridge_0 is
		port (
			clk                       : in  std_logic                     := 'X';             -- clk
			rst_n                     : in  std_logic                     := 'X';             -- reset_n
			avs_address               : in  std_logic_vector(2 downto 0)  := (others => 'X'); -- address
			avs_read                  : in  std_logic                     := 'X';             -- read
			avs_write                 : in  std_logic                     := 'X';             -- write
			avs_writedata             : in  std_logic_vector(31 downto 0) := (others => 'X'); -- writedata
			avs_readdata              : out std_logic_vector(31 downto 0);                    -- readdata
			avs_waitrequest           : out std_logic;                                        -- waitrequest
			cmd_start                 : out std_logic;                                        -- cmd_start
			cmd_write                 : out std_logic;                                        -- cmd_write
			cmd_address               : out std_logic_vector(8 downto 0);                     -- cmd_address
			cmd_writedata             : out std_logic_vector(31 downto 0);                    -- cmd_writedata
			cmd_readdata              : in  std_logic_vector(31 downto 0) := (others => 'X'); -- cmd_readdata
			cmd_busy                  : in  std_logic                     := 'X';             -- cmd_busy
			cmd_done                  : in  std_logic                     := 'X';             -- cmd_done
			cmd_error                 : in  std_logic                     := 'X';             -- cmd_error
			pll_locked_async          : in  std_logic                     := 'X';             -- pll_locked_async
			diagnostic_software_reset : out std_logic                                         -- diagnostic_software_reset
		);
	end component system_nios_iopll_bridge_0;

