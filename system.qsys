        &amp;lt;/register&amp;gt;
        &amp;lt;register&amp;gt;
            &amp;lt;name&amp;gt;${snap_3}&amp;lt;/name&amp;gt;
            &amp;lt;description&amp;gt;&amp;lt;/description&amp;gt;
