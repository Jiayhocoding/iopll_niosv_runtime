        </altera:entity_info>
        <altera:altera_module_parameters>
          <ipxact:parameters>
            <ipxact:parameter parameterId="bspCpu" type="bit">
              <ipxact:name>bspCpu</ipxact:name>
              <ipxact:displayName>BSP CPU</ipxact:displayName>
              <ipxact:value>false</ipxact:value>
